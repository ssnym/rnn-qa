# Paths (relative paths resolve from the project root)
MODEL_PATH=config/rnn_checkpoint.pt
DATA_FILE=data/qa-text-data.csv

# Model architecture (changing these requires retraining)
EMBEDDING_DIM=50
HIDDEN_DIM=64
UNK_TOKEN="<UNK>"
STRIP_CHARS="?'"

# Inference
CONFIDENCE_THRESHOLD=0.40
FALLBACK_ANSWER="I don't Know"
DEFAULT_QUESTION="What is the capital of France?"

# Training
EPOCHS=20
LEARNING_RATE=0.001

# Runtime
DEVICE=cpu
MODEL_VERSION=1.0.0